#!/bin/sh

# Dotfiles repo
DOTFILES_REPO="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/git"
alias dotfiles="git --git-dir=$DOTFILES_REPO --work-tree=$HOME"

# Paths
export PATH="$HOME/.local/bin/:$PATH"
export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"

export POETRY_CONFIG_DIR="$HOME/.config/pypoetry"

# Aliases
alias ls="ls --color=auto --group-directories-first"
alias l="ls"
alias la="ls -a"

alias vim="nvim"
alias view="nvim -R"

alias uni="cd ~/Desktop/Nextcloud/School/2026"

alias ence361_serial="picocom -b 115200 /dev/tty.usbmodem*"

# Platform specific things
UNAME="$(uname -sr)"

## Mac specific
case "$UNAME" in Darwin*)
	export PATH="/opt/homebrew/bin:$PATH"
	export JAVA_HOME=$(/usr/libexec/java_home -v 1.8)
	export STM32CubeMX_PATH="/Applications/STMicroelectronics/STM32CubeMX.app/Contents/Resources"

	# On macOS use coreutils ls instead (as group-directories-first doesn't exist on mac ls)
	alias ls="gls --color=auto --group-directories-first"
	alias l="ls"
	alias la="ls -a"

	alias exp="open ."
    ;;
esac

## Windows (WSL or Git Bash) specific
case "$UNAME" in Linux*-WSL2|MINGW64*)
	export PATH="$HOME/AppData/Local/bob/nightly/bin:$PATH"

	alias exp="explorer.exe ."
	alias win="cd /mnt/c/Users/William"
	;;
esac

# Private shellrc
if [ -f "$HOME/.shellrc-private" ]; then
    . "$HOME/.shellrc-private"
fi

# Work shellrc
if [ -f "$HOME/.shellrc-work" ]; then
    . "$HOME/.shellrc-work"
fi
