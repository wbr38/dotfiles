{
	"[html]": {
		"editor.defaultFormatter": "vscode.html-language-features"
	},
	"[java]": {
		"editor.defaultFormatter": "redhat.java",
		"editor.formatOnSave": false,
		"editor.inlayHints.enabled": "offUnlessPressed"
	},
	"[markdown]": {
		"diffEditor.ignoreTrimWhitespace": false
	},
	"[plaintext]": {
		"editor.quickSuggestions": {
			"other": "off"
		}
	},
	"[python]": {
		"editor.defaultFormatter": "ms-python.autopep8",
		"editor.formatOnType": true
	},
	"[scss]": {
		"editor.defaultFormatter": "sibiraj-s.vscode-scss-formatter"
	},
	"[typst-code]": {
		"editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
	},
	"[typst]": {
		"editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
	},
	// "[typescript]": {
	// 	"editor.inlayHints.enabled": "offUnlessPressed"
	// },
	// "typescript.inlayHints.parameterNames.enabled": "literals",
	"[xml]": {
		"editor.defaultFormatter": "redhat.vscode-xml"
	},
	"autopep8.args": [
		"--max-line-length",
		"200"
	],
	"black-formatter.args": [
		"--line-length 119"
	],
	"debug.inlineValues": "off",
	"debug.onTaskErrors": "debugAnyway",
	"diffEditor.ignoreTrimWhitespace": false,
	"diffEditor.renderSideBySide": true,
	"editor.codeLens": false,
	"editor.cursorSurroundingLines": 999,
	"editor.fontFamily": "Consolas",
	"editor.fontSize": 14,
	"editor.inlineSuggest.enabled": false,
	"editor.lightbulb.enabled": "off",
	"editor.lineNumbers": "relative",
	"editor.minimap.maxColumn": 70,
	"editor.mouseWheelScrollSensitivity": 1.2,
	"editor.quickSuggestions": {
		"comments": "off",
		"other": "on",
		"strings": "off"
	},
	"editor.renderWhitespace": "none",
	"editor.stickyScroll.enabled": true,
	"editor.wordWrap": "off",
	"explorer.confirmDelete": false,
	"files.associations": {
		"*.html": "liquid"
	},
	"files.autoSave": "afterDelay",
	"files.exclude": {
		// "**/*.o*": true,
		// "**/*.d*": true
	},
	"git.openRepositoryInParentFolders": "always",
	"gitlens.ai.model": "openai:gpt-4o",
	"gitlens.views.scm.grouped.views": {
		"branches": false,
		"commits": false,
		"contributors": false,
		"launchpad": false,
		"remotes": false,
		"repositories": false,
		"searchAndCompare": false,
		"stashes": false,
		"tags": false,
		"worktrees": false
	},
	"gitlens.views.stashes.files.layout": "list",
	"html.autoClosingTags": false,
	"java.configuration.runtimes": [
		{
			"default": true,
			"name": "JavaSE-21",
			"path": "C:\\Program Files\\Java\\jdk-21"
		}
	],
	"leetcode.defaultLanguage": "python3",
	"leetcode.hint.commandShortcut": false,
	"leetcode.hint.commentDescription": false,
	"leetcode.hint.configWebviewMarkdown": false,
	"leetcode.workspaceFolder": "/home/wsl/Projects/leetcode",
	"OcpCadViewer.render.ambient_intensity": 0,
	"OcpCadViewer.render.direct_intensity": 0.97,
	"OcpCadViewer.render.metalness": 0.11,
	"OcpCadViewer.render.roughness": 0.7,
	"OcpCadViewer.view.rotate_speed": 0.5,
	"pylint.args": [
		"--rcfile=${workspaceFolder}/.pylintrc"
	],
	"python.analysis.typeCheckingMode": "standard",
	"python.languageServer": "Pylance",
	"python.testing.unittestEnabled": false,
	"redhat.telemetry.enabled": false,
	"remote.autoForwardPortsSource": "hybrid",
	"remote.SSH.configFile": "C:\\Users\\William\\.ssh\\config",
	"remote.SSH.remotePlatform": {
		"botnet": "linux",
		"botnet_nuc": "linux",
		"botnetnuc": "linux",
		"uc": "linux"
	},
	"security.workspace.trust.enabled": false,
	"svg.preview.boundingBox": false,
	"svg.preview.transparencyGrid": false,
	"terminal.integrated.defaultProfile.linux": "zsh",
	"terminal.integrated.defaultProfile.windows": "Git Bash",
	"terminal.integrated.fontSize": 14,
	"terminal.integrated.profiles.windows": {
		"Command Prompt": {
			"args": [],
			"icon": "terminal-cmd",
			"path": [
				"${env:windir}\\Sysnative\\cmd.exe",
				"${env:windir}\\System32\\cmd.exe"
			]
		},
		"Git Bash": {
			"source": "Git Bash"
		},
		"PowerShell": {
			"icon": "terminal-powershell",
			"source": "PowerShell"
		},
		"Ubuntu (WSL)": {
			"args": [
				"-d",
				"Ubuntu"
			],
			"path": "C:\\WINDOWS\\System32\\wsl.exe"
		}
	},
	"terminal.integrated.scrollback": 1000,
	"terminal.integrated.shellIntegration.enabled": false,
	"terminal.integrated.shellIntegration.history": 0,
	"tinymist.formatterMode": "typstyle",
	"vim.cursorStylePerMode.normal": "block-outline",
	"vim.useSystemClipboard": true,
	"vim.vimrc.enable": true,
	"vim.vimrc.path": "~/.vimrc",
	"window.menuBarVisibility": "visible",
	"workbench.colorCustomizations": {
		"tree.indentGuidesStroke": "#fbc4ff"
	},
	"workbench.editorAssociations": {
		"*.svg": "default"
	},
	"workbench.tree.indent": 16
}
